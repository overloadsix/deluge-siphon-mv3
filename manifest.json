{
  "manifest_version": 3,
  "name": "Deluge Siphon MV3",
  "version": "1.0.1",
  "description": "Send magnet links directly to Deluge WebUI.",
  "permissions": ["storage", "contextMenus", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_popup": "popup.html", "default_title": "Deluge Siphon"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}]
}
